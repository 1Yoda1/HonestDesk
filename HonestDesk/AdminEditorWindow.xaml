<Window x:Class="HonestDesk.AdminEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HonestDesk · Администрирование" Width="1380" Height="850"
        MinWidth="1160" MinHeight="720" WindowStartupLocation="CenterOwner">
    <Grid Background="#F4F6FB">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
        <Border Background="#10182B" Padding="28,0">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Администрирование" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                        <Border Background="#382648" CornerRadius="8" Padding="9,4" Margin="12,1,0,0">
                            <TextBlock Text="ЗАЩИЩЁННАЯ СЕССИЯ" Foreground="#E6C9FF" FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Загрузка конфигурации…" Foreground="#8F9BBC" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Content="Реквизиты публикации"
                            Click="CredentialsButton_Click" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource GhostButton}" Content="Обновить"
                            Click="ReloadButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
                    <StackPanel Margin="18,14">
                        <TextBlock Text="Клиенты" FontSize="17" FontWeight="SemiBold"/>
                        <TextBox x:Name="ClientSearchBox" Margin="0,10,0,0" Padding="10,7"
                                 TextChanged="ClientSearchBox_TextChanged" ToolTip="Поиск по названию, ClientId или ИНН"/>
                    </StackPanel>
                    <DataGrid x:Name="ClientsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEF1F6" SelectionChanged="ClientsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="КЛИЕНТ" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="CLIENT ID" Binding="{Binding ClientId}" Width="125"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="16,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SoftButton}" Content="+ Новый клиент" Click="AddClientButton_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource SoftButton}" Content="Удалить" Click="DeleteClientButton_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Карточка клиента" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Изменения остаются локальным черновиком до публикации."
                                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                                        Content="Применить к черновику" Click="ApplyClientButton_Click"/>
                            </Grid>
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="Название" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="NameBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="ClientId" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="ClientIdBox"/></StackPanel>
                                <StackPanel Grid.Row="2"><TextBlock Text="ИНН" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="InnBox"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Архитектура" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><ComboBox x:Name="ArchitectureBox"><ComboBoxItem Content="x64"/><ComboBoxItem Content="x86"/></ComboBox></StackPanel>
                                <StackPanel Grid.Row="4"><TextBlock Text="Пароль продавца" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="ClientPasswordBox"/></StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2"><TextBlock Text="Токен ЧЗ" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="TokenBox"/></StackPanel>
                                <StackPanel Grid.Row="6"><TextBlock Text="Пароль RuDesktop" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="RuPasswordBox"/></StackPanel>
                                <StackPanel Grid.Row="6" Grid.Column="2">
                                    <TextBlock Text="Возможности клиента" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,7"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="With1CCheck" Content="Драйвер 1С для АТОЛ" Margin="0,0,18,8"/>
                                        <CheckBox x:Name="BackupCheck" Content="Резервная копия ЛМ" Margin="0,0,18,8"/>
                                        <CheckBox x:Name="RuEnabledCheck" Content="RuDesktop включён" Margin="0,0,18,8"/>
                                        <CheckBox x:Name="RuAutoPasswordCheck" Content="Предлагать настройку пароля"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            <Border Background="#F8F9FC" BorderBrush="#E8ECF4" BorderThickness="1"
                                    CornerRadius="12" Padding="14" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Персональные версии клиента" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="В списке показаны версии файлов из серверного каталога assets. Глобальная версия указана явно."
                                               Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                                            <ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="ЛМ ЧЗ" FontSize="9" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ClientLmVersionBox" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="АТОЛ" FontSize="9" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ClientAtolVersionBox" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="4"><TextBlock Text="ЕСМ" FontSize="9" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ClientEsmVersionBox" Margin="0,5,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="6"><TextBlock Text="CONTROLLER" FontSize="9" Foreground="{StaticResource Muted}"/><ComboBox x:Name="ClientControllerVersionBox" Margin="0,5,0,0"/></StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Версии компонентов" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Глобальные версии применяются, если у клиента нет override. Список формируется из /api/admin/assets."
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                                    <ColumnDefinition Width="12"/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="HONESTFLOW" FontSize="9" Foreground="{StaticResource Muted}"/><ComboBox x:Name="GlobalHonestFlowBox" IsEditable="True" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="ЛМ ЧЗ" FontSize="9" Foreground="{StaticResource Muted}"/><ComboBox x:Name="GlobalLmBox" IsEditable="True" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="АТОЛ" FontSize="9" Foreground="{StaticResource Muted}"/><ComboBox x:Name="GlobalAtolBox" IsEditable="True" Margin="0,5,0,0"/></StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="ЕСМ" FontSize="9" Foreground="{StaticResource Muted}"/><ComboBox x:Name="GlobalEsmBox" IsEditable="True" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="CONTROLLER" FontSize="9" Foreground="{StaticResource Muted}"/><ComboBox x:Name="GlobalControllerBox" IsEditable="True" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="Персональные версии клиента редактируются в расширенном ConfigEditor."
                                               Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Каталог доступных файлов" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Метаданные загружаются с HonestLicenseServer. «Папка» открывает публичную папку; точный путь указан в таблице."
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,14"/>
                            <DataGrid x:Name="AssetsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      MaxHeight="280" RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="КОМПОНЕНТ" Binding="{Binding Component}" Width="110"/>
                                    <DataGridTextColumn Header="ВЕРСИЯ" Binding="{Binding Version}" Width="100"/>
                                    <DataGridTextColumn Header="АРХ." Binding="{Binding Architecture}" Width="65"/>
                                    <DataGridTextColumn Header="ФАЙЛ" Binding="{Binding FileName}" Width="*"/>
                                    <DataGridTextColumn Header="РАЗМЕР" Binding="{Binding DisplaySize}" Width="85"/>
                                    <DataGridTextColumn Header="ПУТЬ" Binding="{Binding YandexPath}" Width="170"/>
                                    <DataGridTemplateColumn Header="ССЫЛКА" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding LinkCaption}" Padding="8,4" Click="OpenAssetLink_Click"
                                                        IsEnabled="{Binding HasLink}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E8ECF4" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <TextBlock x:Name="DraftText" Text="Изменений нет" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SoftButton}" Content="Сохранить локальный черновик"
                            Click="SaveDraftButton_Click" Margin="0,0,10,0"/>
                    <Button x:Name="PublishButton" Style="{StaticResource PrimaryButton}" Content="Проверить и опубликовать"
                            Click="PublishButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
