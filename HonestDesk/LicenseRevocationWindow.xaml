<Window x:Class="HonestDesk.LicenseRevocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отозвать лицензию" Width="700" Height="430" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="#F4F6FB" Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Отозвать лицензию" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock x:Name="DescriptionText" Grid.Row="1" TextWrapping="Wrap" LineHeight="21"
                   Foreground="#475467" Margin="0,12,0,18"/>
        <DataGrid x:Name="LicensesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DEVICE ID" Binding="{Binding DeviceId}" Width="*"/>
                <DataGridTextColumn Header="REVISION" Binding="{Binding Revision}" Width="90"/>
                <DataGridTextColumn Header="ВЫДАНА" Binding="{Binding IssuedAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                <DataGridTextColumn Header="ДЕЙСТВУЕТ ДО" Binding="{Binding ValidUntilUtc, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Style="{StaticResource SoftButton}" Content="Отмена" Width="110" Height="42" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Отозвать лицензию" Width="180" Height="42" Click="Revoke_Click"/>
        </StackPanel>
    </Grid>
</Window>
