<Window x:Class="HonestDesk.OperatorDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Операторские устройства" Width="1120" Height="680" MinWidth="940" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="#F4F6FB" Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Операторские устройства" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="Сервер хранит их как обычные устройства с подписанной операторской лицензией. История лицензий сохраняется."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
        </StackPanel>
        <TabControl Grid.Row="1">
            <TabItem Header="Опубликованные">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="PublishedStatusText" Text="Загрузка с HonestLicenseServer…" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource SoftButton}" Content="Обновить" Click="ReloadButton_Click"/>
                    </Grid>
                    <DataGrid x:Name="PublishedDevicesGrid" Grid.Row="1" Margin="0,10" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" SelectionChanged="PublishedDevicesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="КЛИЕНТ" Binding="{Binding ClientName}" Width="1.1*"/>
                            <DataGridTextColumn Header="CLIENT ID" Binding="{Binding ClientId}" Width="140"/>
                            <DataGridTextColumn Header="УСТРОЙСТВО" Binding="{Binding DeviceName}" Width="1.1*"/>
                            <DataGridTextColumn Header="DEVICE ID" Binding="{Binding DeviceId}" Width="1.25*"/>
                            <DataGridTextColumn Header="СТАТУС" Binding="{Binding DeviceStatus}" Width="90"/>
                            <DataGridTextColumn Header="ЛИЦЕНЗИЯ" Binding="{Binding LicenseStatus}" Width="95"/>
                            <DataGridTextColumn Header="REV" Binding="{Binding Revision}" Width="55"/>
                            <DataGridTextColumn Header="РЕГИСТРАЦИЯ" Binding="{Binding RegisteredAtUtc, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="125"/>
                            <DataGridTextColumn Header="ДЕЙСТВУЕТ ДО" Binding="{Binding ValidUntilUtc, StringFormat={}{0:dd.MM.yyyy}}" Width="105"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="EnableDeviceButton" Style="{StaticResource SoftButton}" Content="Включить устройство" IsEnabled="False" Click="EnableDeviceButton_Click" Margin="0,0,8,0"/>
                        <Button x:Name="DisableDeviceButton" Style="{StaticResource SoftButton}" Content="Отключить устройство" IsEnabled="False" Click="DisableDeviceButton_Click" Margin="0,0,8,0"/>
                        <Button x:Name="RevokeGrantButton" Style="{StaticResource SoftButton}" Content="Отозвать лицензию" IsEnabled="False" Click="RevokeGrantButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Следующая публикация">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Черновик списка для следующей подписанной публикации. Изменения попадут на сервер только после публикации лицензий."
                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <DataGrid x:Name="DraftDevicesGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DEVICE ID" Binding="{Binding DeviceId}" Width="1.3*"/>
                            <DataGridTextColumn Header="НАЗВАНИЕ" Binding="{Binding Name}" Width="*"/>
                            <DataGridCheckBoxColumn Header="ВКЛ" Binding="{Binding Enabled}" Width="55"/>
                            <DataGridTextColumn Header="КОММЕНТАРИЙ" Binding="{Binding Comment}" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource SoftButton}" Content="+ Добавить в черновик" Click="AddDraftButton_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource SoftButton}" Content="Убрать из черновика" Click="RemoveDraftButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SoftButton}" Content="Отмена" Click="CancelButton_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Применить черновик" Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
