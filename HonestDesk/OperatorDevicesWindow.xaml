<Window x:Class="HonestDesk.OperatorDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Операторские устройства" Width="850" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="#F4F6FB" Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Операторские устройства" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="Эти устройства получают все функции независимо от выбранного клиента."
                       Foreground="{StaticResource Muted}" Margin="0,4,0,14"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DEVICE ID" Binding="{Binding DeviceId}" Width="1.3*"/>
                    <DataGridTextColumn Header="НАЗВАНИЕ" Binding="{Binding Name}" Width="*"/>
                    <DataGridCheckBoxColumn Header="ВКЛ" Binding="{Binding Enabled}" Width="55"/>
                    <DataGridTextColumn Header="КОММЕНТАРИЙ" Binding="{Binding Comment}" Width="1.4*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SoftButton}" Content="+ Добавить" Click="AddButton_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SoftButton}" Content="Удалить" Click="DeleteButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SoftButton}" Content="Отмена" Click="CancelButton_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Применить" Click="ApplyButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
