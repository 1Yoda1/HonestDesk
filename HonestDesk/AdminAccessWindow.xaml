<Window x:Class="HonestDesk.AdminAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Административный доступ" Width="470" Height="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="#F4F6FB">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="#10182B" Padding="28,24">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Административный доступ" Foreground="White"
                           FontSize="23" FontWeight="SemiBold"/>
                <TextBlock x:Name="SubtitleText" Text="Разблокируйте редактор конфигурации"
                           Foreground="#8F9BBC" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="24">
            <StackPanel>
                <TextBlock Text="Пароль администратора" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox" KeyDown="PasswordBox_KeyDown"/>
                <StackPanel x:Name="ConfirmationPanel" Margin="0,14,0,0">
                    <TextBlock Text="Повторите пароль" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" KeyDown="PasswordBox_KeyDown"/>
                </StackPanel>
                <TextBlock x:Name="HintText" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                           FontSize="11" Margin="0,14,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="#D94F64" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{StaticResource SoftButton}" Content="Отмена" Click="CancelButton_Click" Margin="0,0,10,0"/>
                    <Button x:Name="UnlockButton" Style="{StaticResource PrimaryButton}" Content="Разблокировать"
                            Click="UnlockButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
