<Window x:Class="HonestDesk.ClientProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка клиента" Width="760" Height="680" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="#F4F6FB">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#10182B" Padding="28,24">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="ClientNameText" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ClientIdText" Foreground="#8F9BBC" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#1B2948" CornerRadius="12" Padding="14,9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#48D39C" Margin="0,1,8,0"/>
                        <TextBlock Text="КОНФИГУРАЦИЯ НАЙДЕНА" Foreground="#C9D2EE" FontSize="10" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24">
                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ПРОФИЛЬ" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="ProfileText" Margin="0,12,0,0" LineHeight="23"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="ДОСТУП И ЗАЩИТА" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="SecurityText" Margin="0,12,0,0" LineHeight="23" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Компоненты HonestFlow" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Пустое значение означает использование глобальной версии."
                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                <ColumnDefinition/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="HONESTFLOW" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="HonestFlowVersionText" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="ЛМ ЧЗ" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="LmVersionText" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="АТОЛ" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="AtolVersionText" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="ЕСМ" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="EsmVersionText" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="CONTROLLER" Foreground="{StaticResource Muted}" FontSize="9"/><TextBlock x:Name="ControllerVersionText" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Теги и возможности" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TagsText" Foreground="{StaticResource Muted}" Margin="0,10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E8ECF4" BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <TextBlock Text="Секретные значения намеренно скрыты и не копируются в HonestDesk."
                           Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SoftButton}" Content="Закрыть" Click="CloseButton_Click" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Администрирование" Click="AdminButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
