<Window x:Class="HonestDesk.DestructiveConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" MinHeight="250"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Background="#F4F6FB" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" LineHeight="21"
                   Foreground="#475467" Margin="0,14,0,24"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SoftButton}" Content="Отмена" MinWidth="110" Height="42"
                    Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" MinWidth="170" Height="42"
                    Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
