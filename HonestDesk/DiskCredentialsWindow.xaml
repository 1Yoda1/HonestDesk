<Window x:Class="HonestDesk.DiskCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Доступ к Яндекс.Диску" Width="470" Height="355"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="#F4F6FB">
        <Border Style="{StaticResource Card}" Margin="24">
            <StackPanel>
                <TextBlock Text="Доступ к публикации" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="Реквизиты сохраняются только для текущего пользователя Windows и защищаются DPAPI."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,18"/>
                <TextBlock Text="Логин Яндекс.Диска" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="LoginBox"/>
                <TextBlock Text="Пароль приложения" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <PasswordBox x:Name="PasswordBox"/>
                <TextBlock x:Name="ErrorText" Foreground="#D94F64" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource SoftButton}" Content="Отмена" Click="CancelButton_Click" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
