<UserControl x:Class="HonestDesk.ConnectionRequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Canvas}" Foreground="{StaticResource Ink}"
             FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="30,28,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="130"/>
            <RowDefinition Height="280"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Подключение Service" FontSize="27" FontWeight="SemiBold"/>
                <TextBlock Text="Заявки с сайта HonestFlow" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                    Content="Обновить" VerticalAlignment="Center" Click="RefreshButton_Click"/>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,18,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Статус" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="StatusFilter" Width="155" SelectedIndex="0" SelectionChanged="StatusFilter_SelectionChanged">
                    <ComboBoxItem Content="Все" Tag=""/>
                    <ComboBoxItem Content="Новые" Tag="New"/>
                    <ComboBoxItem Content="В работе" Tag="InProgress"/>
                    <ComboBoxItem Content="Завершённые" Tag="Completed"/>
                    <ComboBoxItem Content="Отклонённые" Tag="Rejected"/>
                </ComboBox>
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="Данные ещё не загружены" Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap" Margin="0,9,0,0"/>
        </StackPanel>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
            <DataGrid x:Name="RequestsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                      BorderThickness="0" Background="White" MinRowHeight="38"
                      SelectionChanged="RequestsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAtLocal, StringFormat={}{0:dd.MM HH:mm}}" Width="110"/>
                    <DataGridTextColumn Header="Имя" Binding="{Binding ContactName}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="Компания" Binding="{Binding Company}" Width="*" MinWidth="100"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="145"/>
                    <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="100"/>
                    <DataGridTextColumn Header="РМК" Binding="{Binding WorkplaceCount}" Width="55"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="105"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Детали заявки" FontSize="15" FontWeight="SemiBold"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,12">
                    <TextBox x:Name="DetailsText" Text="Выберите заявку" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" Background="Transparent" Padding="0"/>
                </ScrollViewer>
                <WrapPanel x:Name="ActionsPanel" Grid.Row="2" IsEnabled="False">
                    <Button Style="{StaticResource PrimaryButton}" Content="Взять в работу" Tag="InProgress" Click="ChangeStatus_Click" Margin="0,0,10,4"/>
                    <Button Style="{StaticResource SoftButton}" Content="Завершить" Tag="Completed" Click="ChangeStatus_Click" Margin="0,0,10,4"/>
                    <Button Style="{StaticResource SoftButton}" Content="Отклонить" Tag="Rejected" Click="ChangeStatus_Click" Margin="0,0,10,4"/>
                    <Button Style="{StaticResource SoftButton}" Content="Вернуть в новые" Tag="New" Click="ChangeStatus_Click" Margin="0,0,10,4"/>
                    <Button x:Name="DeleteButton" Style="{StaticResource SoftButton}" Content="Удалить ПД навсегда" Tag="Delete"
                            Foreground="#B42318" Click="DeleteRequest_Click" Margin="0,0,0,4"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
