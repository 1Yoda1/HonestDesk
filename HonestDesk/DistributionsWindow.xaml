<Window x:Class="HonestDesk.DistributionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дистрибутивы — HonestDesk" Width="1320" Height="850"
        MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Дистрибутивы" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Подписанные выпуски Cloud.ru, global-версии и фактическая выдача клиентам"
                           Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderStatusText" Text="Загружаем каталог…"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Style="{StaticResource SoftButton}" Content="Обновить" Click="RefreshButton_Click"/>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="2">
            <TabItem Header="Каталог и выдача">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="16"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Опубликованные файлы" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Каждая строка — неизменяемая версия для конкретной архитектуры."
                                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="SetGlobalButton" Style="{StaticResource PrimaryButton}"
                                        Content="Назначить global" Click="SetGlobalButton_Click" VerticalAlignment="Center"/>
                            </Grid>
                            <DataGrid Grid.Row="2" x:Name="AssetsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                      SelectionMode="Single" SelectionChanged="AssetsGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="КОМПОНЕНТ" Binding="{Binding Component}" Width="120"/>
                                    <DataGridTextColumn Header="ВЕРСИЯ" Binding="{Binding Version}" Width="110"/>
                                    <DataGridTextColumn Header="АРХ." Binding="{Binding Architecture}" Width="65"/>
                                    <DataGridTextColumn Header="ФАЙЛ" Binding="{Binding FileName}" Width="*"/>
                                    <DataGridTextColumn Header="РАЗМЕР" Binding="{Binding DisplaySize}" Width="90"/>
                                    <DataGridTextColumn Header="ХРАНИЛИЩЕ" Binding="{Binding Storage}" Width="100"/>
                                    <DataGridTextColumn Header="ПОДПИСЬ" Binding="{Binding Signature}" Width="145"/>
                                    <DataGridTextColumn Header="СТАТУС" Binding="{Binding CurrentStatus}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Что получит HonestFlow" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Показывает global, override, effective и файл с учётом архитектуры клиента."
                                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2" x:Name="ClientBox" MinWidth="310" VerticalAlignment="Center"
                                          SelectionChanged="ClientBox_SelectionChanged" DisplayMemberPath="Display"/>
                            </Grid>
                            <DataGrid Grid.Row="2" x:Name="ResolutionGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="КОМПОНЕНТ" Binding="{Binding Component}" Width="115"/>
                                    <DataGridTextColumn Header="GLOBAL" Binding="{Binding GlobalVersion}" Width="100"/>
                                    <DataGridTextColumn Header="OVERRIDE" Binding="{Binding OverrideVersion}" Width="100"/>
                                    <DataGridTextColumn Header="EFFECTIVE" Binding="{Binding EffectiveVersion}" Width="100"/>
                                    <DataGridTextColumn Header="АРХ." Binding="{Binding AssetArchitecture}" Width="65"/>
                                    <DataGridTextColumn Header="ФАЙЛ" Binding="{Binding FileName}" Width="*"/>
                                    <DataGridTextColumn Header="API-ПУТЬ" Binding="{Binding DownloadUrl}" Width="260"/>
                                    <DataGridTextColumn Header="ГОТОВНОСТЬ" Binding="{Binding Status}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Загрузить выпуск">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                    <Border Style="{StaticResource Card}" MaxWidth="900" HorizontalAlignment="Left">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Новый подписанный выпуск" FontSize="21" FontWeight="SemiBold"/>
                                <TextBlock Text="HonestDesk вычислит SHA-256, подпишет паспорт и отправит файл напрямую в Cloud.ru частями. Сервер файл не принимает."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Компонент" FontWeight="SemiBold"/><ComboBox x:Name="ComponentBox" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Версия" FontWeight="SemiBold"/><TextBox x:Name="VersionBox" Margin="0,6,0,0"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Архитектура" FontWeight="SemiBold"/><ComboBox x:Name="ArchitectureBox" Margin="0,6,0,0"/></StackPanel>
                            </Grid>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Файл .exe, .msi или .zip" FontWeight="SemiBold"/><TextBox x:Name="FilePathBox" Margin="0,6,0,0" IsReadOnly="True"/></StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SoftButton}" Content="Выбрать файл" Click="BrowseFileButton_Click" VerticalAlignment="Bottom"/>
                            </Grid>

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Закрытый release-ключ" FontWeight="SemiBold"/><TextBox x:Name="KeyPathBox" Margin="0,6,0,0" IsReadOnly="True"/></StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SoftButton}" Content="Выбрать ключ" Click="BrowseKeyButton_Click" VerticalAlignment="Bottom"/>
                            </Grid>

                            <Grid Grid.Row="8">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Пароль release-ключа" FontWeight="SemiBold"/>
                                    <PasswordBox x:Name="KeyPasswordBox" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                    <CheckBox x:Name="SetCurrentCheck" Content="После загрузки назначить global-версией"/>
                                    <TextBlock Text="Без флага файл добавится в каталог, но текущая версия не изменится."
                                               Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="10">
                                <ProgressBar x:Name="UploadProgress" Height="12" Minimum="0" Maximum="100"/>
                                <TextBlock x:Name="UploadStatusText" Text="Готово к выбору файла" Margin="0,8,0,0"
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="12" Orientation="Horizontal">
                                <Button x:Name="UploadButton" Style="{StaticResource PrimaryButton}" Content="Подписать и загрузить" Click="UploadButton_Click"/>
                                <Button x:Name="CancelUploadButton" Style="{StaticResource SoftButton}" Content="Отменить" Click="CancelUploadButton_Click"
                                        Margin="10,0,0,0" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
